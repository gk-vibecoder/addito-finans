---
import { buttonVariants } from '@/components/ui/button';
import { AnimatedSection } from '@/components/ui/AnimatedSection';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="w-full bg-primary py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6 text-center">

    <AnimatedSection client:visible slow>
      <span class="inline-flex items-center rounded-full border border-primary-foreground/20 bg-primary-foreground/10 px-3 py-1 text-xs font-medium text-primary-foreground mb-6">
        {t.hero.badge}
      </span>
    </AnimatedSection>

    <AnimatedSection client:visible slow delay={0.12}>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-primary-foreground max-w-4xl mx-auto leading-[1.1]">
        {t.hero.headline}
      </h1>
    </AnimatedSection>

    <AnimatedSection client:visible slow delay={0.24}>
      <p class="mt-6 text-lg md:text-xl text-primary-foreground/70 max-w-2xl mx-auto leading-relaxed">
        {t.hero.description}
      </p>
    </AnimatedSection>

    <AnimatedSection client:visible slow delay={0.36}>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="#"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 bg-primary-foreground text-primary hover:bg-primary-foreground/90 transition-colors duration-150"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href="#"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium h-11 px-8 border border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/10 transition-colors duration-150"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
      <p class="mt-4 text-xs text-primary-foreground/50">
        {t.hero.note}
      </p>
    </AnimatedSection>

    <AnimatedSection client:visible slow delay={0.6}>
      <div class="mt-16 flex flex-col sm:flex-row items-center justify-center divide-y sm:divide-y-0 sm:divide-x divide-primary-foreground/20">
        {t.stats.map(({ value, label }) => (
          <div class="text-center px-10 py-4 sm:py-0">
            <p class="text-2xl font-bold text-primary-foreground">{value}</p>
            <p class="mt-1 text-sm text-primary-foreground/60">{label}</p>
          </div>
        ))}
      </div>
    </AnimatedSection>

  </div>

  <!-- Logo strip -->
  <div class="mt-16">
    <div
      class="overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]"
      aria-hidden="true"
    >
      <div class="flex w-max gap-16 py-10 [animation:var(--animate-slider)] hover:[animation-play-state:paused]">
        <!-- Set A -->
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
          Bergström &amp; Co
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="7"/></svg>
          Linné Bygg AB
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><polygon points="8,1 15,13 1,13"/></svg>
          Sundqvist Tech
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="6"/></svg>
          Ekström Handel
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
          Nilsson Juridik
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1l2.5 5H15l-4 3.5 1.5 5.5L8 12l-4.5 3 1.5-5.5L1 6h4.5z"/></svg>
          Åkerlund Group
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="6" width="14" height="4" rx="2"/></svg>
          Holmberg Invest
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="4" cy="8" r="3"/><circle cx="12" cy="8" r="3"/></svg>
          Carlsson &amp; Partners
        </span>
        <!-- Set B — duplicate for seamless infinite loop -->
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
          Bergström &amp; Co
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="7"/></svg>
          Linné Bygg AB
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><polygon points="8,1 15,13 1,13"/></svg>
          Sundqvist Tech
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="6"/></svg>
          Ekström Handel
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
          Nilsson Juridik
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1l2.5 5H15l-4 3.5 1.5 5.5L8 12l-4.5 3 1.5-5.5L1 6h4.5z"/></svg>
          Åkerlund Group
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="1" y="6" width="14" height="4" rx="2"/></svg>
          Holmberg Invest
        </span>
        <span class="flex items-center gap-2 text-primary-foreground/50 font-semibold text-sm tracking-tight whitespace-nowrap">
          <svg class="w-4 h-4 opacity-60" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="4" cy="8" r="3"/><circle cx="12" cy="8" r="3"/></svg>
          Carlsson &amp; Partners
        </span>
      </div>
    </div>
  </div>

</section>
