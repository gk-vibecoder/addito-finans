---
import { AnimatedSection } from '@/components/ui/AnimatedSection';
import { getLangFromUrl, useTranslations, getLocalePath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = t.financialServicesSection;
const ctaHref = getLocalePath(lang, '/financial-services');
---

<section class="border-t border-border">
  <!-- Header row: headline left, description right -->
  <AnimatedSection client:visible className="mx-auto max-w-6xl px-6 pt-16 pb-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">{s.eyebrow}</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground max-w-lg">
          {s.headline}
        </h2>
      </div>
      <p class="text-muted-foreground max-w-sm md:text-right leading-relaxed text-sm">
        {s.description}
      </p>
    </div>
  </AnimatedSection>

  <!-- Split panels -->
  <AnimatedSection client:visible delay={0.1} className="mx-auto max-w-6xl px-6 pb-16">
    <div class="grid md:grid-cols-2 rounded-xl overflow-hidden border border-border">

      <!-- Factoring — primary bg -->
      <a
        href={ctaHref}
        class="group bg-primary p-8 md:p-10 flex flex-col gap-6 hover:bg-primary/95 transition-colors duration-200"
      >
        <div class="flex items-start justify-between">
          <span class="inline-block rounded-md border border-primary-foreground/20 px-2 py-1 text-xs font-medium text-primary-foreground/70 uppercase tracking-wider">
            {s.factoring.title}
          </span>
          <svg class="w-4 h-4 text-primary-foreground/40 translate-x-0 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 13L13 3M13 3H6M13 3v7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div>
          <p class="font-mono text-5xl font-bold text-primary-foreground/20 mb-4">90%</p>
          <p class="text-primary-foreground/60 text-xs uppercase tracking-wider mb-2">{s.factoring.tagline}</p>
          <p class="text-primary-foreground leading-relaxed text-sm">{s.factoring.body}</p>
        </div>

        <span class="mt-auto inline-flex items-center gap-1.5 text-xs font-medium text-primary-foreground/60 group-hover:text-primary-foreground transition-colors duration-150">
          {s.cta}
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 6h8M7 3l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <!-- Financing — card bg, split horizontally inside -->
      <a
        href={ctaHref}
        class="group bg-card p-8 md:p-10 flex flex-col gap-6 hover:bg-accent/40 transition-colors duration-200 border-l border-border"
      >
        <div class="flex items-start justify-between">
          <span class="inline-block rounded-md border border-border px-2 py-1 text-xs font-medium text-muted-foreground uppercase tracking-wider">
            {s.debt.title}
          </span>
          <svg class="w-4 h-4 text-muted-foreground/40 translate-x-0 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 13L13 3M13 3H6M13 3v7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div>
          <p class="font-mono text-5xl font-bold text-border mb-4">0 kr</p>
          <p class="text-primary text-xs uppercase tracking-wider font-medium mb-2">{s.debt.tagline}</p>
          <p class="text-muted-foreground leading-relaxed text-sm">{s.debt.body}</p>
        </div>

        <span class="mt-auto inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground group-hover:text-foreground transition-colors duration-150">
          {s.cta}
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 6h8M7 3l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

    </div>
  </AnimatedSection>
</section>
