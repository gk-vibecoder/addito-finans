---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { seo } from '@/config/seo';

const sections = [
  {
    heading: 'Tolkning och definitioner',
    body: 'Termer med stor begynnelsebokstav i denna policy har definierade betydelser. "Bolaget" avser Addito Finans AB. "Tjänsten" avser Addito Finans webbplats på additofinans.se. "Du" avser den person som använder Tjänsten. "Personuppgifter" avser all information som rör en identifierad eller identifierbar person. "Användningsdata" avser data som samlas in automatiskt vid användning av Tjänsten.',
  },
  {
    heading: 'Vilka uppgifter vi samlar in',
    body: 'Vi samlar in personuppgifter som du lämnar direkt — till exempel din e-postadress och ditt namn när du kontaktar oss eller bokar en konsultation. Vi samlar även in användningsdata automatiskt, inklusive din IP-adress, webbläsartyp, besökta sidor, tid på sidor och enhetsinformation. Vi använder cookies för att stödja analys och förbättra användarupplevelsen.',
  },
  {
    heading: 'Hur vi använder dina uppgifter',
    body: 'Vi använder dina uppgifter för att besvara dina förfrågningar, hantera ditt konto, uppfylla avtalsförpliktelser, kontakta dig med tjänsterelaterad kommunikation och analysera användningstrender för att förbättra vår webbplats. Vi säljer inte dina personuppgifter till tredje part.',
  },
  {
    heading: 'Delning av uppgifter',
    body: 'Vi kan dela din information med tjänsteleverantörer som hjälper oss att driva vår webbplats och leverera våra tjänster, med förbehåll för sekretesskyldigheter. Uppgifter kan överföras i samband med en affärstransaktion som en fusion eller förvärv. Vi kan lämna ut uppgifter när det krävs enligt lag, för att skydda våra rättigheter eller för att förhindra skada.',
  },
  {
    heading: 'Lagring av uppgifter',
    body: 'Vi lagrar personuppgifter endast så länge det är nödvändigt för de ändamål som beskrivs i denna policy, inklusive efterlevnad av rättsliga skyldigheter enligt bokföringslagen. Användningsdata lagras under kortare perioder om de inte behövs för säkerhetsanalys.',
  },
  {
    heading: 'Internationella överföringar',
    body: 'Dina uppgifter kan behandlas av tjänsteleverantörer i andra länder. Vi säkerställer att lämpliga skyddsåtgärder finns på plats för att skydda dina uppgifter i enlighet med GDPR och tillämplig svensk dataskyddslagstiftning.',
  },
  {
    heading: 'Dina rättigheter',
    body: 'Enligt GDPR har du rätt att få tillgång till, korrigera eller radera dina personuppgifter. Du kan också invända mot behandling eller begära begränsning av den. För att utöva dessa rättigheter kontaktar du oss på hej@additofinans.se. Vi behandlar din begäran utan dröjsmål om vi inte är rättsligt skyldiga att behålla viss information.',
  },
  {
    heading: 'Säkerhet',
    body: 'Vi implementerar tekniska och organisatoriska åtgärder för att skydda dina uppgifter mot obehörig åtkomst, förlust eller missbruk. All data krypteras i vila och under överföring. Ingen överföringsmetod via internet är 100% säker, men vi granskar och förbättrar kontinuerligt våra säkerhetsrutiner.',
  },
  {
    heading: 'Barns integritet',
    body: 'Vår tjänst riktar sig inte till personer under 18 år. Vi samlar inte medvetet in personuppgifter från minderåriga. Om du tror att en minderårig har lämnat personuppgifter till oss, kontakta oss och vi tar bort dem omgående.',
  },
  {
    heading: 'Länkar till tredjepartswebbplatser',
    body: 'Vår webbplats kan innehålla länkar till externa webbplatser. Vi ansvarar inte för integritetspraxis eller innehållet på dessa webbplatser och uppmuntrar dig att granska deras integritetspolicyer självständigt.',
  },
  {
    heading: 'Ändringar i denna policy',
    body: 'Vi kan uppdatera denna integritetspolicy från tid till annan. Ändringar publiceras på denna sida med ett uppdaterat "Senast uppdaterad"-datum. Fortsatt användning av vår webbplats efter ändringar utgör ditt godkännande av den uppdaterade policyn.',
  },
  {
    heading: 'Kontakt',
    body: 'Om du har frågor om denna integritetspolicy eller hur vi hanterar dina uppgifter, kontakta oss på hej@additofinans.se.',
  },
];
---

<BaseLayout
  title={seo.privacyPolicy.title}
  description={seo.privacyPolicy.description}
  noindex={seo.privacyPolicy.noindex}
  alternateHref="/en/privacy-policy"
>
  <PageHero
    label="Juridiskt"
    title="Integritetspolicy"
    description="Hur vi samlar in, använder och skyddar dina personuppgifter."
  />

  <section class="mx-auto max-w-3xl px-6 py-16 pb-24">
    <p class="text-xs text-muted-foreground mb-12">Senast uppdaterad: mars 2026</p>

    <div class="space-y-10">
      {sections.map(({ heading, body }) => (
        <div>
          <h2 class="text-lg font-semibold text-foreground mb-3">{heading}</h2>
          <p class="text-sm text-muted-foreground leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-xl border border-border bg-muted/30 p-6">
      <p class="text-sm text-muted-foreground">
        Frågor om denna policy? Kontakta oss på{' '}
        <a href="mailto:hej@additofinans.se" class="text-foreground underline underline-offset-4 hover:no-underline">
          hej@additofinans.se
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
