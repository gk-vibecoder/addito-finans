---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/sections/CTA.astro';
import { seo } from '@/config/seo';
import { AnimatedSection } from '@/components/ui/AnimatedSection';
---

<BaseLayout
  title={seo.financialServices.title}
  description={seo.financialServices.description}
  alternateHref="/en/financial-services"
>

  <!-- ─── Custom hero: split layout ──────────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-12 md:pt-24">
    <AnimatedSection client:visible slow className="grid md:grid-cols-5 gap-12 items-start">

      <!-- Left 3 cols: headline + intro -->
      <div class="md:col-span-3">
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-6">Finanstjänster</p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground leading-tight max-w-lg">
          Finansiella lösningar för varje fas av ditt företag.
        </h1>
        <p class="mt-6 text-lg text-muted-foreground leading-relaxed max-w-md">
          Stärk kassaflödet med fakturabelåning eller säkra kapitalet du behöver för att växa. Vi är din oberoende rådgivare — vi arbetar för dig.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#factoring" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
            Fakturabelåning
          </a>
          <a href="#financing" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-4 text-sm font-medium text-foreground hover:bg-accent transition-colors">
            Företagsfinansiering
          </a>
        </div>
      </div>

      <!-- Right 2 cols: stat cards -->
      <div class="md:col-span-2 flex flex-col gap-4 md:pt-8">
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-4xl font-bold text-foreground">90%</p>
          <p class="text-xs text-muted-foreground mt-1">av fakturavärdet utbetalas direkt</p>
        </div>
        <div class="rounded-xl border border-border bg-card p-6">
          <p class="font-mono text-4xl font-bold text-foreground">24h</p>
          <p class="text-xs text-muted-foreground mt-1">genomsnittlig utbetalningstid</p>
        </div>
        <div class="rounded-xl border border-primary/20 bg-primary/5 p-6">
          <p class="font-mono text-4xl font-bold text-primary">0 kr</p>
          <p class="text-xs text-muted-foreground mt-1">ingen säkerhet krävs för fakturabelåning</p>
        </div>
      </div>

    </AnimatedSection>
  </section>

  <!-- ─── Factoring: split section ───────────────────────────────────────────── -->
  <section id="factoring" class="border-t border-border">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <AnimatedSection client:visible className="grid md:grid-cols-2 gap-12 md:gap-16 items-start">

        <!-- Left: content -->
        <div>
          <p class="font-mono text-xs text-muted-foreground mb-6 uppercase tracking-widest">01 — Fakturabelåning</p>
          <h2 class="text-3xl font-bold tracking-tight text-foreground mb-6">
            Sluta finansiera dina kunders betalningsvillkor.
          </h2>
          <p class="text-muted-foreground leading-relaxed mb-8">
            Du fakturerar kunden som vanligt. Vi betalar ut upp till 90 % av fakturans värde direkt — utan att du behöver vänta 30, 60 eller 90 dagar. Vi tar hand om inkasseringen.
          </p>
          <ul class="space-y-3">
            {[
              'Utbetalning inom 24 timmar',
              'Upp till 90 % av fakturans värde',
              'Ingen säkerhet eller borgen krävs',
              'Vi hanterar inkasseringen',
              'Transparent och fast avgiftsmodell',
            ].map((item) => (
              <li class="flex items-center gap-3 text-sm text-muted-foreground">
                <span class="size-1.5 rounded-full bg-primary shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Right: how it works steps -->
        <div class="flex flex-col gap-0">
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-8">Så fungerar det</p>
          {[
            { step: '01', title: 'Du fakturerar kunden', body: 'Skicka fakturan som vanligt och ladda upp en kopia till oss. Processen tar under fem minuter.' },
            { step: '02', title: 'Vi betalar ut direkt', body: 'Inom 24 timmar har du upp till 90 % av fakturans värde på ditt konto. Inga frågor, ingen väntan.' },
            { step: '03', title: 'Vi hanterar betalningen', body: 'När kunden betalar till oss regleras resterande belopp minus vår avgift. Enkelt och transparent.' },
          ].map(({ step, title, body }, i) => (
            <div class:list={['flex gap-5 pb-8 ml-4', i < 2 && 'border-l border-border']}>
              <div class="flex flex-col items-center shrink-0 -ml-4">
                <div class="size-8 rounded-full border border-border bg-background flex items-center justify-center shrink-0">
                  <span class="font-mono text-xs text-muted-foreground">{step}</span>
                </div>
              </div>
              <div class="pb-2">
                <p class="font-semibold text-foreground text-sm mb-1">{title}</p>
                <p class="text-sm text-muted-foreground leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>

      </AnimatedSection>
    </div>
  </section>

  <!-- ─── Financing: flipped split section ───────────────────────────────────── -->
  <section id="financing" class="border-t border-border bg-muted/20">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <AnimatedSection client:visible className="grid md:grid-cols-2 gap-12 md:gap-16 items-start">

        <!-- Left: financing type cards -->
        <div class="flex flex-col gap-4 md:order-1">
          {[
            {
              icon: '◈',
              title: 'Företagslån',
              body: 'Kapital för investeringar, expansion eller rörelsekapital. Vi jämför villkor från flera långivare och hjälper dig förhandla.',
            },
            {
              icon: '⬡',
              title: 'Kreditram',
              body: 'Flexibel kredit för tillfälliga likviditetsbehov. Du betalar bara ränta på det du faktiskt använder.',
            },
            {
              icon: '◆',
              title: 'Skuldrådgivning',
              body: 'Har du befintliga lån med ogynnsamma villkor? Vi analyserar din skuldsituation och identifierar möjligheter till omstrukturering och bättre villkor.',
            },
          ].map(({ icon, title, body }) => (
            <div class="rounded-xl border border-border bg-card p-5 flex gap-4 items-start">
              <div class="size-9 rounded-lg bg-muted flex items-center justify-center shrink-0 mt-0.5">
                <span class="text-foreground text-sm">{icon}</span>
              </div>
              <div>
                <p class="font-semibold text-foreground text-sm">{title}</p>
                <p class="text-xs text-muted-foreground mt-1 leading-relaxed">{body}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Right: content -->
        <div class="md:order-2">
          <p class="font-mono text-xs text-muted-foreground mb-6 uppercase tracking-widest">02 — Företagsfinansiering</p>
          <h2 class="text-3xl font-bold tracking-tight text-foreground mb-6">
            Rätt kapital. På dina villkor.
          </h2>
          <p class="text-muted-foreground leading-relaxed mb-6">
            Vi är oberoende rådgivare — vi arbetar för dig, inte för bankerna. Det betyder att du alltid får ett ärligt råd om vilken finansieringsform som faktiskt passar din verksamhet.
          </p>
          <p class="text-muted-foreground leading-relaxed mb-8">
            Från att analysera ditt kapitalbehov till att förhandla villkor med långivare — vi är med hela vägen.
          </p>
          <a
            href="/contact"
            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
          >
            Boka ett möte
          </a>
        </div>

      </AnimatedSection>
    </div>
  </section>

  <!-- ─── Stats strip ──────────────────────────────────────────────────────────── -->
  <section class="border-t border-border">
    <AnimatedSection client:visible className="mx-auto max-w-6xl px-6 py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-border rounded-xl overflow-hidden">
        {[
          { value: '90%', label: 'Fakturavärde utbetalt direkt' },
          { value: '24h', label: 'Genomsnittlig utbetalningstid' },
          { value: '0 kr', label: 'Ingen säkerhet krävs' },
          { value: '100%', label: 'Oberoende rådgivning' },
        ].map(({ value, label }) => (
          <div class="bg-card px-6 py-8 flex flex-col gap-1">
            <p class="font-mono text-3xl font-bold text-foreground">{value}</p>
            <p class="text-xs text-muted-foreground leading-snug">{label}</p>
          </div>
        ))}
      </div>
    </AnimatedSection>
  </section>

  <CTA ctaHref="/contact" showForm={false} />

</BaseLayout>
