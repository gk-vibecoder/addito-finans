---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import FAQ from '@/components/sections/FAQ.astro';
import { seo } from '@/config/seo';
import CTA from '@/components/sections/CTA.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import { Button } from '@/components/ui/button';
import { AnimatedSection } from '@/components/ui/AnimatedSection';

const stats = [
  { value: '2008', label: 'Grundades' },
  { value: '500+', label: 'Nöjda kunder' },
  { value: '15+', label: 'Medarbetare' },
];

const team = [
  { name: 'Anna Lindqvist', role: 'VD & Auktoriserad revisor', initials: 'AL' },
  { name: 'Erik Svensson', role: 'Redovisningschef', initials: 'ES' },
  { name: 'Maria Bergström', role: 'Skattespecialist', initials: 'MB' },
  { name: 'Johan Nilsson', role: 'Lönespecialist', initials: 'JN' },
];

const values = [
  {
    icon: '◆',
    title: 'Noggrannhet',
    body: 'Vi arbetar med precision och uppmärksamhet på detaljer. Din ekonomi förtjänar ingenting mindre.',
  },
  {
    icon: '◉',
    title: 'Transparens',
    body: 'Inga dolda avgifter, inga överraskningar. Du vet alltid vad vi gör och vad det kostar.',
  },
  {
    icon: '◈',
    title: 'Partnerskap',
    body: 'Vi ser oss som din ekonomiska partner — inte bara din leverantör. Din framgång är vår framgång.',
  },
  {
    icon: '◎',
    title: 'Tillgänglighet',
    body: 'En dedikerad kontaktperson som känner din verksamhet och finns tillgänglig när du behöver.',
  },
  {
    icon: '⬡',
    title: 'Proaktivitet',
    body: 'Vi identifierar möjligheter och risker innan de uppstår — och meddelar dig i god tid.',
  },
  {
    icon: '▣',
    title: 'Digital-first',
    body: 'Moderna verktyg och digitala processer gör samarbetet smidigt och effektivt.',
  },
];
---

<BaseLayout
  title={seo.aboutUs.title}
  description={seo.aboutUs.description}
  alternateHref="/en/about-us"
>
  <PageHero
    label="Om oss"
    title="Vi tar hand om ekonomin. Du tar hand om affärerna."
    description="Addito Finans grundades 2008 med en enkel övertygelse: företagare ska kunna fokusera på sin kärnverksamhet utan att behöva oroa sig för ekonomin."
  />

  <!-- Mission & Stats -->
  <section class="border-y border-border bg-muted/30 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <AnimatedSection client:visible className="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Vår vision</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
            Redovisning som en strategisk fördel.
          </h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Addito Finans grundades för att lösa ett problem vi såg hos hundratals företagare: ekonomin tog för mycket tid och energi från det som faktiskt skapar värde.
          </p>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Vår mission är att vara mer än en redovisningsbyrå. Vi är din ekonomiska partner — proaktiva, tillgängliga och alltid i din hörna. Oavsett om du precis startat ditt bolag eller har 50 anställda.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-6">
          {stats.map(({ value, label }) => (
            <div class="rounded-xl border border-border bg-card p-6 text-center">
              <p class="text-2xl font-bold text-foreground">{value}</p>
              <p class="mt-1 text-xs text-muted-foreground leading-snug">{label}</p>
            </div>
          ))}
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Approach -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <AnimatedSection client:visible className="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Vårt sätt att arbeta</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          En dedikerad kontaktperson. Alltid.
        </h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          På Addito Finans slipper du förklara ditt företag om och om igen. Du tilldelas en fast kontaktperson som lär känna din verksamhet på djupet — och finns tillgänglig när du behöver svar.
        </p>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Vi arbetar med moderna, digitala verktyg som gör samarbetet enkelt och transparent. All dokumentation är ordnad, alla deadlines hålls.
        </p>
        <div class="mt-8">
          <Button variant="outline" size="lg" asChild>
            <a href="/contact">Kontakta oss</a>
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {[
          { label: 'Grundades', value: '2008' },
          { label: 'Kontor', value: 'Stockholm' },
          { label: 'Certifiering', value: 'Auktoriserad' },
          { label: 'Specialisering', value: 'SME-bolag' },
        ].map(({ label, value }) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <p class="text-xs text-muted-foreground uppercase tracking-wider mb-1">{label}</p>
            <p class="font-semibold text-foreground">{value}</p>
          </div>
        ))}
      </div>
    </AnimatedSection>
  </section>

  <!-- Team -->
  <section class="border-y border-border bg-muted/30 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <AnimatedSection client:visible className="text-center mb-16">
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Teamet</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          Människorna bakom Addito Finans
        </h2>
        <p class="mt-4 text-muted-foreground max-w-xl mx-auto">
          Erfarna specialister inom redovisning, skatt och lön — dedikerade till att ge dig bästa möjliga service.
        </p>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.15} className="flex flex-wrap justify-center gap-6">
        {team.map(({ name, role, initials }) => (
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col items-center gap-3 text-center w-48">
            <div class="size-14 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center">
              <span class="text-sm font-semibold text-primary">{initials}</span>
            </div>
            <div>
              <p class="font-semibold text-foreground text-sm">{name}</p>
              <p class="text-xs text-muted-foreground mt-0.5">{role}</p>
            </div>
          </div>
        ))}
      </AnimatedSection>

      <!-- Join CTA -->
      <AnimatedSection client:visible delay={0.3} className="mt-16 rounded-xl border border-border bg-card p-8 max-w-2xl mx-auto text-center">
        <h3 class="text-xl font-bold text-foreground">Vill du bli en del av teamet?</h3>
        <p class="mt-3 text-sm text-muted-foreground leading-relaxed">
          Vi letar alltid efter duktiga redovisningsekonomer och skattespecialister. Hör av dig om du tror att du passar in.
        </p>
        <div class="mt-6">
          <Button variant="outline" asChild>
            <a href="/contact">Skicka en intresseanmälan</a>
          </Button>
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <AnimatedSection client:visible className="text-center mb-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Kultur & värderingar</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
        Det vi står för
      </h2>
    </AnimatedSection>

    <AnimatedSection client:visible delay={0.15} className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {values.map(({ icon, title, body }) => (
        <div class="rounded-xl border border-border p-6">
          <div class="mb-4 size-10 rounded-lg bg-primary/10 flex items-center justify-center">
            <span class="text-primary text-base">{icon}</span>
          </div>
          <h3 class="font-semibold text-foreground">{title}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{body}</p>
        </div>
      ))}
    </AnimatedSection>
  </section>

  <HowItWorks />
  <CTA ctaHref="/contact" showForm={false} />
</BaseLayout>
