---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import CTA from '@/components/sections/CTA.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import { seo } from '@/config/seo';
import { AnimatedSection } from '@/components/ui/AnimatedSection';
const services = [
  {
    icon: '◈',
    title: 'Bokföring',
    tagline: 'Alltid à jour. Inga överraskningar.',
    body: 'Vi sköter din löpande redovisning noggrant och i tid. Du får full insyn i ekonomin och slipper oroa dig för att något missas. Månadsavstämning ingår alltid.',
    includes: ['Löpande bokföring', 'Månadsavstämning', 'Kvittohantering', 'Bankavstämning'],
  },
  {
    icon: '◎',
    title: 'Skatteplanering',
    tagline: 'Betala vad du ska — inte mer.',
    body: 'Proaktiv skatteplanering som sparar pengar lagligt. Vi analyserar din situation löpande och ger konkreta råd — inte bara vid deklarationstid.',
    includes: ['Löpande skatteoptimering', 'Periodiseringsfonder', 'Utdelningsplanering', 'Deklarationsrådgivning'],
  },
  {
    icon: '◆',
    title: 'Lönehantering',
    tagline: 'Effektivt. Korrekt. I tid.',
    body: 'Fullständig löneadministration för ditt företag — från lönekörning och arbetsgivardeklarationer till semesterhantering och kollektivavtal.',
    includes: ['Löneutbetalning', 'Arbetsgivardeklarationer', 'Semesterhantering', 'Förmånsvärden'],
  },
  {
    icon: '⬡',
    title: 'Årsredovisning',
    tagline: 'Precision och inlämning i rätt tid.',
    body: 'Vi upprättar årsredovisning och inkomstdeklaration professionellt och med precision. Alltid inlämnade i god tid — aldrig en förseningsavgift.',
    includes: ['Årsredovisning', 'Inkomstdeklaration', 'Bolagsdeklaration', 'Inlämning till Bolagsverket'],
  },
  {
    icon: '◉',
    title: 'Momshantering',
    tagline: 'Rätt moms. Varje period.',
    body: 'Korrekt momsredovisning varje period, oavsett om du har månadsvis, kvartalsvis eller årsvis redovisning. Vi håller koll på regler och undantag.',
    includes: ['Momsdeklaration', 'EU-moms', 'Momsrådgivning', 'Exportmoms'],
  },
  {
    icon: '▣',
    title: 'Företagsrådgivning',
    tagline: 'Din ekonomiska partner.',
    body: 'Ekonomisk rådgivning vid viktiga affärsbeslut — val av bolagsform, due diligence, budgetering, likviditetsprognoser och strategisk planering.',
    includes: ['Val av bolagsform', 'Budgetering', 'Likviditetsprognoser', 'Bolagsstart'],
  },
];
---

<BaseLayout
  title={seo.services.title}
  description={seo.services.description}
  alternateHref="/en/services"
>
  <PageHero
    label="Redovisning"
    title="Allt du behöver. Under ett och samma tak."
    description="Från löpande bokföring till strategisk rådgivning — vi erbjuder ett komplett utbud av redovisningstjänster för svenska företag."
  />

  <!-- Services grid -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <AnimatedSection client:visible className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(({ icon, title, tagline, body, includes }) => (
        <div class="rounded-xl border border-border bg-card p-6 flex flex-col gap-4 hover:border-primary/40 transition-colors duration-200">
          <div class="size-11 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <span class="text-primary text-base">{icon}</span>
          </div>
          <div>
            <h2 class="font-semibold text-foreground">{title}</h2>
            <p class="text-xs text-primary font-medium mt-0.5">{tagline}</p>
          </div>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">{body}</p>
          <ul class="space-y-1 border-t border-border pt-4">
            {includes.map((item) => (
              <li class="flex items-center gap-2 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-primary/60 shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </AnimatedSection>
  </section>

  <!-- Process -->
  <HowItWorks />

  <!-- Pricing note -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <AnimatedSection client:visible>
      <div class="rounded-xl border border-border bg-muted/30 p-8 md:p-12 grid md:grid-cols-2 gap-8 items-center">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Prissättning</p>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground">
            Fasta månadsavgifter. Inga dolda kostnader.
          </h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Vi erbjuder transparenta, fasta månadsavgifter anpassade efter din verksamhets storlek och behov. Du vet alltid vad du betalar — och vad du får.
          </p>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Boka ett kostnadsfritt möte så tar vi fram ett skräddarsytt prisförslag för just din situation.
          </p>
        </div>
        <div class="space-y-4">
          {[
            { label: 'Enskild firma', desc: 'Bokföring, deklaration och löpande rådgivning' },
            { label: 'Aktiebolag', desc: 'Komplett redovisning, lön och skatteplanering' },
            { label: 'Tillväxtbolag', desc: 'Skräddarsytt paket med prioriterad hantering' },
          ].map(({ label, desc }) => (
            <div class="flex items-start gap-3 rounded-lg border border-border bg-card p-4">
              <span class="size-2 rounded-full bg-primary mt-1.5 shrink-0" />
              <div>
                <p class="font-medium text-foreground text-sm">{label}</p>
                <p class="text-xs text-muted-foreground mt-0.5">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </AnimatedSection>
  </section>

  <CTA ctaHref="/contact" showForm={false} />
</BaseLayout>
