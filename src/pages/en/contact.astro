---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { seoEn } from '@/config/seo.en';
import PageHero from '@/components/sections/PageHero.astro';
import { Button } from '@/components/ui/button';
import { AnimatedSection } from '@/components/ui/AnimatedSection';

const contactDetails = [
  { label: 'Email', value: 'hello@additofinans.se', href: 'mailto:hello@additofinans.se' },
  { label: 'Phone', value: '+46 8 123 456 78', href: 'tel:+46812345678' },
  { label: 'Address', value: 'Storgatan 12, 111 23 Stockholm', href: null },
  { label: 'LinkedIn', value: 'linkedin.com/company/addito-finans', href: 'https://www.linkedin.com/company/addito-finans' },
];

const officeHours = [
  { day: 'Monday – Friday', hours: '08:00 – 17:00' },
  { day: 'Saturday – Sunday', hours: 'Closed' },
];
---

<BaseLayout
  title={seoEn.contact.title}
  description={seoEn.contact.description}
  alternateHref="/contact"
>
  <PageHero
    label="Contact"
    title="Ready to take the next step?"
    description="Book a free 30-minute meeting and we will explain how we can help your business. No obligations."
  />

  <!-- Contact form + details -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <AnimatedSection client:visible className="grid lg:grid-cols-3 gap-16">

      <!-- Form -->
      <div class="lg:col-span-2">
        <form class="space-y-4" action="#" method="POST">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-foreground mb-1.5">Full name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Jane Smith"
                class="w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-foreground mb-1.5">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="jane@yourcompany.com"
                class="w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
              />
            </div>
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-foreground mb-1.5">Company</label>
            <input
              id="company"
              name="company"
              type="text"
              placeholder="Your Company Ltd"
              class="w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
            />
          </div>
          <div>
            <label for="topic" class="block text-sm font-medium text-foreground mb-1.5">What is it about?</label>
            <input
              id="topic"
              name="topic"
              type="text"
              placeholder="Bookkeeping, tax planning, switching accountants..."
              class="w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-foreground mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Tell us a bit about your business and what you need help with..."
              class="w-full rounded-md border border-border bg-background px-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-none transition-colors"
            ></textarea>
          </div>
          <Button type="submit" size="lg" client:visible>Send message</Button>
          <p class="text-xs text-muted-foreground">We respond within 24 hours on business days.</p>
        </form>
      </div>

      <!-- Contact details -->
      <div class="space-y-8">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Contact details</p>
          <div class="space-y-4">
            {contactDetails.map(({ label, value, href }) => (
              <div>
                <p class="text-xs text-muted-foreground mb-0.5">{label}</p>
                {href ? (
                  <a href={href} class="text-sm font-medium text-foreground hover:text-primary transition-colors">
                    {value}
                  </a>
                ) : (
                  <p class="text-sm font-medium text-foreground">{value}</p>
                )}
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-border bg-muted/30 p-5">
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-3">Office hours</p>
          <div class="space-y-2">
            {officeHours.map(({ day, hours }) => (
              <div class="flex justify-between">
                <p class="text-sm text-muted-foreground">{day}</p>
                <p class="text-sm font-medium text-foreground">{hours}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-primary/20 bg-primary/5 p-5">
          <p class="text-xs font-semibold tracking-widest uppercase text-primary mb-2">Free consultation</p>
          <p class="text-sm text-foreground font-medium">30 minutes. No obligations.</p>
          <p class="text-sm text-muted-foreground mt-1">
            We get to know your business and explain how we can help — at no cost.
          </p>
        </div>
      </div>
    </AnimatedSection>
  </section>
</BaseLayout>
