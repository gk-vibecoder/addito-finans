---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsStrip from '@/components/sections/StatsStrip.astro';
import Features from '@/components/sections/Features.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import { seoEn } from '@/config/seo.en';

const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'Addito Finans',
  description: 'Modern accounting for growing businesses.',
  url: 'https://additofinans.se/en',
  telephone: '+46812345678',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Storgatan 12',
    postalCode: '111 23',
    addressLocality: 'Stockholm',
    addressCountry: 'SE',
  },
  priceRange: '$$',
  openingHours: 'Mo-Fr 08:00-17:00',
});
---

<BaseLayout
  title={seoEn.home.title}
  description={seoEn.home.description}
  pageSchema={localBusinessSchema}
  alternateHref="/"
>
  <Hero />
  <StatsStrip />
  <Features />
  <HowItWorks />
  <Testimonials />
  <FAQ />
  <CTA ctaHref="/en/contact" showForm={false} />
</BaseLayout>
