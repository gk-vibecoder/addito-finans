---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { seoEn } from '@/config/seo.en';

const sections = [
  {
    heading: 'Introduction',
    body: 'additofinans.se is a website operated by Addito Finans AB. By accessing or using our website and services, you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our services.',
  },
  {
    heading: '1. Acceptance of Terms',
    body: 'By accessing our website or engaging our services, you confirm that you have read, understood, and agree to be bound by these Terms of Service and our Privacy Policy. These terms apply to all users of the website.',
  },
  {
    heading: '2. Eligibility',
    body: 'You must be at least 18 years of age to use our services. By accessing or using our website, you represent and warrant that you meet this requirement.',
  },
  {
    heading: '3. User Responsibilities',
    body: 'You are responsible for providing accurate and complete information when contacting us or engaging our services. You agree to keep this information up to date and to comply with all applicable laws and regulations.',
  },
  {
    heading: '4. Services Provided',
    body: 'Addito Finans AB provides accounting, bookkeeping, tax planning, payroll administration, and business advisory services to Swedish companies. The information on this website is for general informational purposes only and does not constitute professional advice specific to your situation.',
  },
  {
    heading: '5. Privacy and Data Protection',
    body: 'Addito Finans AB complies with applicable data protection regulations including GDPR. Your use of our website and services is also governed by our Privacy Policy, which is incorporated into these Terms by reference.',
  },
  {
    heading: '6. User Conduct',
    body: 'You agree not to use our website in any unlawful manner, to attempt to gain unauthorised access to any part of our systems, or to transmit malicious code, spam, or harmful content.',
  },
  {
    heading: '7. Intellectual Property',
    body: 'All content on this website, including text, graphics, and logos, is the property of Addito Finans AB and is protected by Swedish and international copyright law. You may not reproduce or distribute any content without our prior written consent.',
  },
  {
    heading: '8. Limitation of Liability',
    body: 'Our website is provided "as is" without warranties of any kind. Addito Finans AB shall not be liable for any indirect, incidental, or consequential damages arising from your use of this website. Our liability for professional accounting services is governed by the engagement letter entered into with each client.',
  },
  {
    heading: '9. Changes to These Terms',
    body: 'We may update these Terms of Service from time to time. Material changes will be posted on this page. Continued use of our website after changes are posted constitutes your acceptance of the revised Terms.',
  },
  {
    heading: '10. Governing Law',
    body: 'These Terms are governed by the laws of Sweden. Any disputes arising from these Terms shall be subject to the exclusive jurisdiction of the Swedish courts.',
  },
];
---

<BaseLayout
  title={seoEn.termsOfService.title}
  description={seoEn.termsOfService.description}
  noindex={seoEn.termsOfService.noindex}
  alternateHref="/terms-of-service"
>
  <PageHero
    label="Legal"
    title="Terms of Service"
    description="The terms and conditions governing your use of Addito Finans services."
  />

  <section class="mx-auto max-w-3xl px-6 py-16 pb-24">
    <p class="text-xs text-muted-foreground mb-12">Addito Finans AB · Storgatan 12, 111 23 Stockholm</p>

    <div class="space-y-10">
      {sections.map(({ heading, body }) => (
        <div>
          <h2 class="text-lg font-semibold text-foreground mb-3">{heading}</h2>
          <p class="text-sm text-muted-foreground leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-xl border border-border bg-muted/30 p-6">
      <p class="text-sm text-muted-foreground">
        Questions about these Terms? Contact us at{' '}
        <a href="mailto:hej@additofinans.se" class="text-foreground underline underline-offset-4 hover:no-underline">
          hej@additofinans.se
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
