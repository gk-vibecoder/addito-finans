---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { seoEn } from '@/config/seo.en';
import PageHero from '@/components/sections/PageHero.astro';
import CTA from '@/components/sections/CTA.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import { Button } from '@/components/ui/button';
import { AnimatedSection } from '@/components/ui/AnimatedSection';

const stats = [
  { value: '2008', label: 'Founded' },
  { value: '500+', label: 'Happy clients' },
  { value: '15+', label: 'Team members' },
];

const team = [
  { name: 'Anna Lindqvist', role: 'CEO & Authorised Accountant', initials: 'AL' },
  { name: 'Erik Svensson', role: 'Head of Accounting', initials: 'ES' },
  { name: 'Maria Bergström', role: 'Tax Specialist', initials: 'MB' },
  { name: 'Johan Nilsson', role: 'Payroll Specialist', initials: 'JN' },
];

const values = [
  {
    icon: '◆',
    title: 'Accuracy',
    body: 'We work with precision and attention to detail. Your finances deserve nothing less.',
  },
  {
    icon: '◉',
    title: 'Transparency',
    body: 'No hidden fees, no surprises. You always know what we do and what it costs.',
  },
  {
    icon: '◈',
    title: 'Partnership',
    body: 'We see ourselves as your financial partner — not just your supplier. Your success is our success.',
  },
  {
    icon: '◎',
    title: 'Availability',
    body: 'A dedicated contact person who knows your business and is available when you need them.',
  },
  {
    icon: '⬡',
    title: 'Proactivity',
    body: 'We identify opportunities and risks before they arise — and notify you well in advance.',
  },
  {
    icon: '▣',
    title: 'Digital-first',
    body: 'Modern tools and digital processes make collaboration smooth and efficient.',
  },
];
---

<BaseLayout
  title={seoEn.aboutUs.title}
  description={seoEn.aboutUs.description}
  alternateHref="/about-us"
>
  <PageHero
    label="About us"
    title="We handle the finances. You handle the business."
    description="Addito Finans was founded in 2008 with a simple conviction: business owners should be able to focus on their core operations without worrying about finances."
  />

  <!-- Mission & Stats -->
  <section class="border-y border-border bg-muted/30 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <AnimatedSection client:visible className="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Our vision</p>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
            Accounting as a strategic advantage.
          </h2>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Addito Finans was founded to solve a problem we saw in hundreds of business owners: managing finances was taking too much time and energy away from what actually creates value.
          </p>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            Our mission is to be more than an accounting firm. We are your financial partner — proactive, available, and always in your corner. Whether you have just started your company or have 50 employees.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-6">
          {stats.map(({ value, label }) => (
            <div class="rounded-xl border border-border bg-card p-6 text-center">
              <p class="text-2xl font-bold text-foreground">{value}</p>
              <p class="mt-1 text-xs text-muted-foreground leading-snug">{label}</p>
            </div>
          ))}
        </div>
      </AnimatedSection>
    </div>
  </section>

  <!-- Approach -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <AnimatedSection client:visible className="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">How we work</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          One dedicated contact. Always.
        </h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          At Addito Finans, you never have to explain your business over and over again. You are assigned a fixed contact person who gets to know your operations in depth — and is available when you need answers.
        </p>
        <div class="mt-8">
          <Button variant="outline" size="lg" asChild>
            <a href="/en/contact">Get in touch</a>
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        {[
          { label: 'Founded', value: '2008' },
          { label: 'Office', value: 'Stockholm' },
          { label: 'Certification', value: 'Authorised' },
          { label: 'Specialisation', value: 'SME companies' },
        ].map(({ label, value }) => (
          <div class="rounded-xl border border-border bg-card p-5">
            <p class="text-xs text-muted-foreground uppercase tracking-wider mb-1">{label}</p>
            <p class="font-semibold text-foreground">{value}</p>
          </div>
        ))}
      </div>
    </AnimatedSection>
  </section>

  <!-- Team -->
  <section class="border-y border-border bg-muted/30 py-24">
    <div class="mx-auto max-w-6xl px-6">
      <AnimatedSection client:visible className="text-center mb-16">
        <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">The team</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          The people behind Addito Finans
        </h2>
      </AnimatedSection>

      <AnimatedSection client:visible delay={0.15} className="flex flex-wrap justify-center gap-6">
        {team.map(({ name, role, initials }) => (
          <div class="rounded-xl border border-border bg-card p-6 flex flex-col items-center gap-3 text-center w-48">
            <div class="size-14 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center">
              <span class="text-sm font-semibold text-primary">{initials}</span>
            </div>
            <div>
              <p class="font-semibold text-foreground text-sm">{name}</p>
              <p class="text-xs text-muted-foreground mt-0.5">{role}</p>
            </div>
          </div>
        ))}
      </AnimatedSection>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-6 py-24">
    <AnimatedSection client:visible className="text-center mb-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-muted-foreground mb-4">Values</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-foreground">
        What we stand for
      </h2>
    </AnimatedSection>

    <AnimatedSection client:visible delay={0.15} className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {values.map(({ icon, title, body }) => (
        <div class="rounded-xl border border-border p-6">
          <div class="mb-4 size-10 rounded-lg bg-primary/10 flex items-center justify-center">
            <span class="text-primary text-base">{icon}</span>
          </div>
          <h3 class="font-semibold text-foreground">{title}</h3>
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{body}</p>
        </div>
      ))}
    </AnimatedSection>
  </section>

  <HowItWorks />
  <CTA ctaHref="/en/contact" showForm={false} />
</BaseLayout>
