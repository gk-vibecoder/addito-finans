---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { seo } from '@/config/seo';

const sections = [
  {
    heading: 'Inledning',
    body: 'additofinans.se är en webbplats som drivs av Addito Finans AB. Genom att öppna eller använda vår webbplats och våra tjänster godkänner du att vara bunden av dessa användarvillkor. Om du inte godkänner dessa villkor, använd inte våra tjänster.',
  },
  {
    heading: '1. Godkännande av villkor',
    body: 'Genom att öppna vår webbplats eller anlita våra tjänster bekräftar du att du har läst, förstått och godkänner att vara bunden av dessa användarvillkor och vår integritetspolicy. Dessa villkor gäller för alla användare av webbplatsen.',
  },
  {
    heading: '2. Behörighet',
    body: 'Du måste vara minst 18 år gammal för att använda våra tjänster. Genom att öppna eller använda vår webbplats intygar och garanterar du att du uppfyller detta krav.',
  },
  {
    heading: '3. Användaransvar',
    body: 'Du ansvarar för att lämna korrekt och fullständig information när du kontaktar oss eller anlitar våra tjänster. Du förbinder dig att hålla denna information uppdaterad och att följa alla tillämpliga lagar och förordningar.',
  },
  {
    heading: '4. Tillhandahållna tjänster',
    body: 'Addito Finans AB tillhandahåller redovisning, bokföring, skatteplanering, löneadministration och företagsrådgivning till svenska företag. Informationen på denna webbplats är enbart för allmänt informationssyfte och utgör inte professionell rådgivning anpassad till din situation.',
  },
  {
    heading: '5. Integritet och dataskydd',
    body: 'Addito Finans AB följer tillämpliga dataskyddsregler inklusive GDPR. Din användning av vår webbplats och våra tjänster regleras även av vår integritetspolicy, som är inkorporerad i dessa villkor genom hänvisning.',
  },
  {
    heading: '6. Användaruppförande',
    body: 'Du förbinder dig att inte använda vår webbplats på ett olagligt sätt, att inte försöka få obehörig åtkomst till någon del av våra system, eller att överföra skadlig kod, skräppost eller skadligt innehåll.',
  },
  {
    heading: '7. Immateriella rättigheter',
    body: 'Allt innehåll på denna webbplats, inklusive text, grafik och logotyper, tillhör Addito Finans AB och skyddas av svensk och internationell upphovsrättslagstiftning. Du får inte reproducera eller distribuera något innehåll utan vårt skriftliga medgivande.',
  },
  {
    heading: '8. Ansvarsbegränsning',
    body: 'Vår webbplats tillhandahålls "i befintligt skick" utan garantier av något slag. Addito Finans AB ansvarar inte för indirekta, oförutsedda eller följdskador som uppstår på grund av din användning av denna webbplats. Vårt ansvar för professionella redovisningstjänster regleras av det uppdragsavtal som ingåtts med varje klient.',
  },
  {
    heading: '9. Ändringar av dessa villkor',
    body: 'Vi kan uppdatera dessa användarvillkor från tid till annan. Väsentliga ändringar publiceras på denna sida. Fortsatt användning av vår webbplats efter att ändringar har publicerats utgör ditt godkännande av de reviderade villkoren.',
  },
  {
    heading: '10. Tillämplig lag',
    body: 'Dessa villkor regleras av svensk lag. Eventuella tvister som uppstår av dessa villkor ska prövas av svenska domstolar med exklusiv behörighet.',
  },
];
---

<BaseLayout
  title={seo.termsOfService.title}
  description={seo.termsOfService.description}
  noindex={seo.termsOfService.noindex}
  alternateHref="/en/terms-of-service"
>
  <PageHero
    label="Juridiskt"
    title="Användarvillkor"
    description="Villkoren som gäller för din användning av Addito Finans tjänster."
  />

  <section class="mx-auto max-w-3xl px-6 py-16 pb-24">
    <p class="text-xs text-muted-foreground mb-12">Addito Finans AB · Storgatan 12, 111 23 Stockholm</p>

    <div class="space-y-10">
      {sections.map(({ heading, body }) => (
        <div>
          <h2 class="text-lg font-semibold text-foreground mb-3">{heading}</h2>
          <p class="text-sm text-muted-foreground leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 rounded-xl border border-border bg-muted/30 p-6">
      <p class="text-sm text-muted-foreground">
        Frågor om dessa villkor? Kontakta oss på{' '}
        <a href="mailto:hej@additofinans.se" class="text-foreground underline underline-offset-4 hover:no-underline">
          hej@additofinans.se
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
