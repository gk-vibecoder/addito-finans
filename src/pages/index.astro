---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { seo } from '@/config/seo';
import Hero from '@/components/sections/Hero.astro';
import Features from '@/components/sections/Features.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import FAQ from '@/components/sections/FAQ.astro';
import CTA from '@/components/sections/CTA.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';

const localBusinessSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'Addito Finans',
  description: 'Modern redovisning för växande företag.',
  url: 'https://additofinans.se',
  telephone: '+46812345678',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Storgatan 12',
    postalCode: '111 23',
    addressLocality: 'Stockholm',
    addressCountry: 'SE',
  },
  priceRange: '$$',
  openingHours: 'Mo-Fr 08:00-17:00',
});
---

<BaseLayout
  title={seo.home.title}
  description={seo.home.description}
  pageSchema={localBusinessSchema}
  alternateHref="/en"
>
  <Hero />
<Features />
  <HowItWorks />
  <Testimonials />
  <FAQ />
  <CTA ctaHref="/contact" showForm={false} />
</BaseLayout>
